    "/videos/{publicId}/stream": {
      "get": {
        "description": "Streams the owner-scoped ready object and forwards an optional HTTP byte range without buffering storage content in the API.",
        "operationId": "VideoDeliveryController_stream",
        "parameters": [
          {
            "name": "publicId",
            "required": true,
            "in": "path",
            "description": "Public UUID of the ready video.",
            "schema": {
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Entire ready video stream",
            "content": {
              "application/octet-stream": {
                "schema": {
