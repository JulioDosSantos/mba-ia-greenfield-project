    "/channels/{channelId}/videos/uploads": {
      "post": {
        "description": "Creates an owner-scoped draft and multipart upload session. The response exposes only product video identifiers and upload timing metadata.",
        "operationId": "VideosController_createUpload",
        "parameters": [
          {
            "name": "channelId",
            "required": true,
            "in": "path",
            "description": "UUID of the channel that owns the draft.",
            "schema": {
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateVideoUploadDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Video upload draft created",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "id",
                    "public_id",
                    "status",
                    "part_size_bytes",
                    "upload_expires_at"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "public_id": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "status": {
                      "type": "string",
                      "enum": [
                        "DRAFT"
                      ]
                    },
                    "part_size_bytes": {
                      "type": "integer",
                      "example": 5242880
                    },
                    "upload_expires_at": {
                      "type": "string",
                      "format": "date-time"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Validation failed (VALIDATION_ERROR)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid access token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          },
          "403": {
            "description": "Caller does not own the channel (CHANNEL_ACCESS_DENIED)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          },
          "404": {
            "description": "Channel was not found (CHANNEL_NOT_FOUND)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          },
          "413": {
            "description": "Declared size exceeds 10 GB (VIDEO_SIZE_LIMIT_EXCEEDED)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          },
          "415": {
            "description": "MIME type is outside the configured allowlist (UNSUPPORTED_VIDEO_MEDIA_TYPE)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          },
          "503": {
            "description": "Storage is temporarily unavailable (STORAGE_UNAVAILABLE)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          }
        },
        "security": [
          {
            "access-token": []
          }
        ],
        "summary": "Create a video upload draft",
        "tags": [
          "videos"
        ]
      }
    },
    "/channels/{channelId}/videos/{videoId}/upload-parts": {
      "post": {
        "description": "Returns an opaque, short-lived upload capability for each requested part of an owner-scoped draft.",
        "operationId": "VideosController_requestUploadParts",
        "parameters": [
          {
            "name": "videoId",
            "required": true,
            "in": "path",
            "description": "UUID of the video draft.",
            "schema": {
              "format": "uuid"
            }
          },
          {
            "name": "channelId",
            "required": true,
            "in": "path",
            "description": "UUID of the channel that owns the video.",
            "schema": {
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RequestUploadPartsDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Short-lived multipart upload capabilities",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "parts"
                  ],
                  "properties": {
                    "parts": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": [
                          "part_number",
                          "url",
                          "expires_at"
                        ],
                        "properties": {
                          "part_number": {
                            "type": "integer",
                            "minimum": 1
                          },
                          "url": {
                            "type": "string",
                            "format": "uri",
                            "description": "Opaque, short-lived upload capability."
                          },
                          "expires_at": {
                            "type": "string",
                            "format": "date-time"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Validation failed (VALIDATION_ERROR)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid access token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          },
          "403": {
            "description": "Caller does not own the channel (CHANNEL_ACCESS_DENIED)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          },
          "404": {
            "description": "Channel or video was not found (CHANNEL_NOT_FOUND or VIDEO_NOT_FOUND)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          },
          "409": {
            "description": "Video is no longer an active draft (VIDEO_UPLOAD_NOT_DRAFT)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          },
          "410": {
            "description": "Multipart session expired (MULTIPART_UPLOAD_EXPIRED)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          },
          "503": {
            "description": "Storage is temporarily unavailable (STORAGE_UNAVAILABLE)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          }
        },
        "security": [
          {
            "access-token": []
          }
        ],
        "summary": "Sign multipart upload parts",
        "tags": [
          "videos"
        ]
      }
    },
    "/channels/{channelId}/videos/{videoId}/complete-upload": {
      "post": {
        "description": "Confirms owner-supplied multipart ETags, verifies the completed object, and persists one durable processing request.",
        "operationId": "VideosController_completeUpload",
        "parameters": [
          {
            "name": "videoId",
            "required": true,
            "in": "path",
            "description": "UUID of the video draft.",
            "schema": {
              "format": "uuid"
            }
          },
          {
            "name": "channelId",
            "required": true,
            "in": "path",
            "description": "UUID of the channel that owns the video.",
            "schema": {
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CompleteVideoUploadDto"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Upload completed and processing durably requested",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "id",
                    "public_id",
